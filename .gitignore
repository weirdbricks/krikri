# Local-only Claude Code instructions (personal paths/credential workflow -
# never committed, this repo is public)
/CLAUDE.local.md

# Compiled binaries
/bin/

# Crystal dependencies (installed via shards)
/lib/

# Codegen output from build.sh's build_fat_plugin - regenerated every
# build, never hand-edited.
/plugins/.fat_plugin_generated.cr

# Shard lock file (some prefer to commit this, some don't)
# Uncomment the next line if you want to exclude it:
# /shard.lock
# The user's own default inventory at the repo root only - NOT anchoring
# this with a leading / would also match spec/fixtures/*.ini, silently
# excluding the integration-test fixtures from every commit (this
# happened: spec/fixtures/inventory.ini was never actually committed,
# only ever present locally on disk - a fresh clone or CI would have been
# missing it entirely).
/inventory.ini
/spec/tmp/

# crinja differential-harness generated output (scripts/crinja_corpus/README.md)
scripts/crinja_corpus/corpus.jsonl
scripts/crinja_corpus/oracle_python.jsonl
scripts/crinja_corpus/oracle_crinja.jsonl
scripts/crinja_corpus/divergence_report.md

# Local scratch notes from ad-hoc perf-review passes - not part of repo
# history, findings that matter get folded into README.md/commit messages
/SUGGESTED_PERFORMANCE_IMPROVEMENTS.md

# Round retry queues - left over from a real-host benchmark round that
# ran out of time / pairs mid-batch. Same scratch class as
# SUGGESTED_PERFORMANCE_IMPROVEMENTS.md: findings that matter get folded
# into KNOWN_MISSING.md commit messages, never into the repo history
# themselves.
/retry*.txt

# ansible-lint working artifacts. Running `ansible-lint` anywhere under
# the repo drops a `.ansible/` cache (its own collections dir plus a
# .lock) beside the checkout, plus its own rule cache. Both are
# regenerated on demand and neither is ours - this appeared for real
# after linting a stress playbook during the 0.9.635 verification
# round.
/.ansible/
/.ansible-lint-cache/

# Per-run SSH keypair for the container-based IP-reuse test
# (testing/ipreuse/README.md generates it locally; never committed).
/testing/ipreuse/key
/testing/ipreuse/key.pub
