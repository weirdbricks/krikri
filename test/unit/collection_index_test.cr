require "../minitest_helper"
require "file_utils"
require "../../src/krikri/playbook_parser"
require "../../src/krikri/collection_index"

# krikri's module-name reference data: resolution, collection release pins
# and redirect chains all come from krikri's OWN baked tables
# (src/krikri/collection_runtime_data.cr and
# src/krikri/builtin_module_names_data.cr, generated by
# scripts/gen_collection_runtime_data.py and
# scripts/gen_builtin_runtime_data.py). No spec here depends on what this
# machine happens to have installed - several assert exactly that, by
# pointing ANSIBLE_COLLECTIONS_PATH at a scratch tree (or at nothing at
# all) and checking that not one answer moves.
describe Krikri::CollectionIndex do
  # ENV is process-wide AND these specs point HOME/ANSIBLE_COLLECTIONS_PATH at
  # scratch trees that non-serial tests read (profile_tasks spawns with the
  # process HOME, stat expands `$HOME`, ...). serial! only serializes
  # serial-vs-serial, so a concurrent non-serial test would observe the
  # scratch values mid-window and fail - hence exclusive!, which quiesces the
  # whole process. Each scratch value is also restored (not blind-deleted) so
  # later tests see the real one.
  exclusive!

  it "resolves a module file the captured collection ships" do
    Krikri::CollectionIndex.reference_resolves?("community.docker.docker_container")[:resolves].must_equal(true)
  end

  it "does not resolve a module the captured collection does not ship" do
    Krikri::CollectionIndex.reference_resolves?("community.docker.not_a_real_module")[:resolves].must_equal(false)
  end

  it "resolves ansible-core builtin modules as bare names" do
    Krikri::CollectionIndex.reference_resolves?("getent")[:resolves].must_equal(true)
    Krikri::CollectionIndex.builtin_module?("copy").must_equal(true)
  end

  it "does not resolve a bare name that is neither builtin nor redirected (docker)" do
    Krikri::CollectionIndex.builtin_module?("docker").must_equal(false)
    Krikri::CollectionIndex.reference_resolves?("docker")[:resolves].must_equal(false)
  end

  # amazon.aws is in module_scope with an empty captured tree, and ships no
  # `aws_s3` (removed in 2.0), so the builtin redirect chain is a miss;
  # google.cloud kept routing data only, so its chain is undecidable and
  # must never read as a definitive miss (issue #1744: a controller with
  # google.cloud installed resolves gcp_compute_disk).
  it "keeps a redirect into an uncaptured collection undecidable, not a miss" do
    Krikri::CollectionIndex.builtin_module_redirect("aws_s3").must_equal("amazon.aws.aws_s3")
    Krikri::CollectionIndex.reference_resolves?("aws_s3")[:resolves].must_equal(false)
    Krikri::CollectionIndex.reference_resolves?("gcp_compute_disk")[:resolves].must_be_nil
  end

  it "reads only the playbook-adjacent collection tree for the redirect-target escape" do
    dir = PluginSpecHelper.tmp_path("index-adjacent-collections")
    FileUtils.mkdir_p(File.join(dir, "collections", "ansible_collections", "amazon", "aws"))
    Krikri::CollectionIndex.playbook_collection?("amazon", "aws", dir).must_equal(true)
    Krikri::CollectionIndex.playbook_collection?("community", "aws", dir).must_equal(false)
    Krikri::CollectionIndex.playbook_collection?("amazon", "aws", nil).must_equal(false)
  ensure
    FileUtils.rm_rf(dir) if dir && Dir.exists?(dir)
  end

  it "leaves ansible.builtin. spellings to the engine's own resolution (never refuses)" do
    Krikri::CollectionIndex.reference_resolves?("ansible.builtin.sysvinit")[:resolves].must_be_nil
  end

  it "stays undecided for templated names and one-dot names" do
    Krikri::CollectionIndex.reference_resolves?("{{ pkg_mgr }}")[:resolves].must_be_nil
    Krikri::CollectionIndex.reference_resolves?("foo.bar")[:resolves].must_be_nil
  end

  # ------------------------------------------------------------------
  # The whole point of the redesign: NOTHING here reads the controller's
  # installation, so pointing the collection env at a fixture tree cannot
  # move a single answer.

  it "does not resolve a collection module only a fixture tree provides" do
    fixture = PluginSpecHelper.tmp_path("collection-index-fixture")
    FileUtils.mkdir_p(File.join(fixture, "ansible_collections", "testns", "prov", "plugins", "modules"))
    File.write(File.join(fixture, "ansible_collections", "testns", "prov", "plugins", "modules", "thing.py"), "# fixture\n")
    FileUtils.mkdir_p(File.join(fixture, "ansible_collections", "testns", "prov", "plugins", "lookup"))
    File.write(File.join(fixture, "ansible_collections", "testns", "prov", "plugins", "lookup", "thing_lookup.py"), "# fixture\n")

    before_bare = Krikri::CollectionIndex.builtin_module?("thing")
    before_fqcn = Krikri::CollectionIndex.reference_resolves?("testns.prov.thing")[:resolves]
    before_lookup = Krikri::CollectionIndex.bare_lookup_resolves?("thing_lookup")

    prev_paths = ENV["ANSIBLE_COLLECTIONS_PATH"]?
    begin
      ENV["ANSIBLE_COLLECTIONS_PATH"] = fixture
      Krikri::CollectionIndex.reset!

      Krikri::CollectionIndex.builtin_module?("thing").must_equal(before_bare)
      Krikri::CollectionIndex.reference_resolves?("testns.prov.thing")[:resolves].must_equal(before_fqcn)
      Krikri::CollectionIndex.reference_resolves?("testns.prov.thing")[:resolves].must_be_nil
      Krikri::CollectionIndex.bare_lookup_resolves?("thing_lookup").must_equal(before_lookup)
      Krikri::CollectionIndex.bare_lookup_resolves?("thing_lookup").must_equal(false)
      # ... and the collections krikri DOES know still answer the same.
      Krikri::CollectionIndex.reference_resolves?("community.general.ufw")[:resolves].must_equal(true)
      Krikri::CollectionIndex.module_provider_version("ansible.posix.mount").must_equal("2.1.0")
    ensure
      prev_paths ? (ENV["ANSIBLE_COLLECTIONS_PATH"] = prev_paths) : ENV.delete("ANSIBLE_COLLECTIONS_PATH")
      Krikri::CollectionIndex.reset!
    end
  end

  it "does not read a planted ansible-core package for its builtin name set" do
    # A fake install whose modules/ carries a name ansible-core never had,
    # and whose config/ carries a redirect the real runtime does not: if
    # anything here consulted it, the planted name would resolve too.
    # Nothing may move - and `getent` keeps resolving.
    home = PluginSpecHelper.tmp_path("collection-index-fake-ansible")
    pkg = File.join(home, ".local", "lib", "python3.13", "site-packages", "ansible")
    FileUtils.mkdir_p(File.join(pkg, "modules"))
    FileUtils.mkdir_p(File.join(pkg, "config"))
    File.write(File.join(pkg, "modules", "krikri_planted_module.py"), "# planted\n")
    File.write(File.join(pkg, "config", "ansible_builtin_runtime.yml"),
      "plugin_routing:\n  modules:\n    krikri_planted_bare:\n      redirect: krikri_planted.coll.thing\n")

    prev_home = ENV["HOME"]?
    begin
      ENV["HOME"] = home
      Krikri::CollectionIndex.reset!
      Krikri::CollectionIndex.builtin_module?("krikri_planted_module").must_equal(false)
      Krikri::CollectionIndex.builtin_module_redirect("krikri_planted_bare").must_be_nil
      Krikri::CollectionIndex.builtin_module?("getent").must_equal(true)
    ensure
      prev_home ? (ENV["HOME"] = prev_home) : ENV.delete("HOME")
      Krikri::CollectionIndex.reset!
    end
  end

  # ------------------------------------------------------------------
  # The pinned per-module collection releases (the version gates the
  # plugins and the deprecation model ride on).

  it "pins a supported module's resolved collection release" do
    Krikri::CollectionIndex.module_provider_collection("ansible.posix.mount").must_equal("ansible.posix")
    Krikri::CollectionIndex.module_provider_version("ansible.posix.mount").must_equal("2.1.0")
    # The bare spelling follows the builtin-runtime redirect.
    Krikri::CollectionIndex.module_provider_version("mount").must_equal("2.1.0")
    Krikri::CollectionIndex.module_provider_version("community.docker.docker_container").must_equal("5.2.1")
    Krikri::CollectionIndex.module_provider_version("community.general.ufw").must_equal("12.5.0")
    # A name only ansible-core provides, or one no collection ships, pins
    # no collection release at all.
    Krikri::CollectionIndex.module_provider_version("ansible.builtin.copy").must_be_nil
    Krikri::CollectionIndex.module_provider_version("no_such_module_xyzzy").must_be_nil
  end

  it "compares release versions with an unknown release counting as older" do
    Krikri::CollectionIndex.version_before?("2.1.0", 2, 2, 0).must_equal(true)
    Krikri::CollectionIndex.version_before?("2.1.9", 2, 2, 0).must_equal(true)
    Krikri::CollectionIndex.version_before?("2.2.0", 2, 2, 0).must_equal(false)
    Krikri::CollectionIndex.version_before?("2.2.2", 2, 2, 0).must_equal(false)
    Krikri::CollectionIndex.version_before?("12.5.0", 2, 2, 0).must_equal(false)
    Krikri::CollectionIndex.version_before?(nil, 2, 2, 0).must_equal(true)
  end

  # ------------------------------------------------------------------
  # Redirect chains (the task-args finalization message names the chain
  # END, issue #800) come from the captured routing tables.

  it "follows the captured collection's own routing redirect to its chain end" do
    # hetzner.hcloud 5.x renames its legacy hcloud_* FQCNs onto unprefixed
    # module files; krikri's capture carries that table, so the chain
    # resolves without the collection being installed anywhere.
    Krikri::CollectionIndex.module_redirect_chain("hcloud_ssh_key").must_equal("hetzner.hcloud.ssh_key")
    Krikri::CollectionIndex.module_redirect_chain("hetzner.hcloud.hcloud_ssh_key").must_equal("hetzner.hcloud.ssh_key")
    Krikri::CollectionIndex.module_redirect_chain("hetzner.hcloud.ssh_key").must_equal("hetzner.hcloud.ssh_key")
  end

  it "follows the builtin-runtime redirect for a bare name" do
    Krikri::CollectionIndex.builtin_module_redirect("mount").must_equal("ansible.posix.mount")
    Krikri::CollectionIndex.module_redirect_chain("mount").must_equal("ansible.posix.mount")
    Krikri::CollectionIndex.module_redirect_chain("authorized_key").must_equal("ansible.posix.authorized_key")
  end

  it "leaves a name with no redirect entry unchanged" do
    Krikri::CollectionIndex.module_redirect_chain("community.general.ufw").must_equal("community.general.ufw")
  end

  # ------------------------------------------------------------------
  # FQCRs: an extra dotted segment may name a plugin-type SUBDIR.

  it "resolves an FQCR whose subdir segment and resource both name plugin files" do
    Krikri::CollectionIndex.fqcr_subdir_resolves?("community.general.locale_gen.locale_gen").must_equal(true)
    Krikri::CollectionIndex.reference_resolves?("community.general.locale_gen.locale_gen")[:resolves].must_equal(true)
  end

  it "does not resolve an FQCR whose subdir segment names nothing in the collection" do
    Krikri::CollectionIndex.fqcr_subdir_resolves?("community.general.bogus_subdir.locale_gen").must_equal(false)
    Krikri::CollectionIndex.reference_resolves?("community.general.bogus_subdir.locale_gen")[:resolves].must_equal(false)
  end

  it "does not resolve an FQCR whose subdir segment resolves but whose resource file is missing" do
    Krikri::CollectionIndex.fqcr_subdir_resolves?("community.general.locale_gen.nosuchresource").must_equal(false)
  end

  # ------------------------------------------------------------------
  # Lookup names: bare names search every captured collection.

  it "resolves a bare lookup name a captured collection's plugins/lookup ships (issue #751)" do
    Krikri::CollectionIndex.bare_lookup_resolves?("dig").must_equal(true)
  end

  it "does not resolve a bare lookup name nothing captured provides" do
    Krikri::CollectionIndex.bare_lookup_resolves?("nope_nope_bare_missing").must_equal(false)
  end

  it "answers builtin lookup names from the baked ansible-core tables" do
    Krikri::CollectionIndex.bare_lookup_resolves?("file").must_equal(true)
    Krikri.builtin_runtime_redirects[2]["redis"]?.must_equal("community.general.redis")
  end

  # ------------------------------------------------------------------
  # Action-plugin scope: which collection action plugins real IMPORTS (it
  # only searches the collections the task scopes).

  it "finds an action plugin for a scoped bare name only through the listed collection" do
    Krikri::CollectionIndex.action_plugin_in_scope?("k8s", [] of String).must_equal(false)
    Krikri::CollectionIndex.action_plugin_in_scope?("k8s", ["kubernetes.core"]).must_equal(true)
    Krikri::CollectionIndex.action_plugin_in_scope?("kubernetes.core.k8s", [] of String).must_equal(true)
  end

  it "finds an unscoped bare name through the builtin ACTION routing redirect" do
    Krikri::CollectionIndex.action_plugin_in_scope?("synchronize", [] of String).must_equal(true)
    Krikri::CollectionIndex.action_plugin_in_scope?("patch", [] of String).must_equal(true)
  end

  it "leaves names with no action plugin anywhere out of scope" do
    Krikri::CollectionIndex.action_plugin_in_scope?("nosuchaction", [] of String).must_equal(false)
  end

  # ------------------------------------------------------------------
  # Role-private sources (files beside the playbook are NOT reference data
  # from an installation - they are executed as python).

  it "finds a role-private library/ module source" do
    root = PluginSpecHelper.tmp_path("collection-index-library")
    FileUtils.mkdir_p(File.join(root, "roles", "librole", "library"))
    File.write(File.join(root, "roles", "librole", "library", "getthing.py"), "# fixture\n")
    Krikri::CollectionIndex.reference_resolves?("getthing",
      role_path: File.join(root, "roles", "librole"))[:resolves].must_equal(true)
    Krikri::CollectionIndex.library_module?("getthing", File.join(root, "roles", "librole"), nil).must_equal(true)
  end

  it "does not count a dangling library/ symlink as a module source" do
    root = PluginSpecHelper.tmp_path("collection-index-dangling")
    FileUtils.mkdir_p(File.join(root, "roles", "dangrole", "library"))
    File.symlink("../submodules/missing/getthing2.py",
      File.join(root, "roles", "dangrole", "library", "getthing2.py"))
    Krikri::CollectionIndex.reference_resolves?("getthing2",
      role_path: File.join(root, "roles", "dangrole"))[:resolves].must_equal(false)
  end

  it "resolves a bare action name via a role-local action_plugins/<name>.py file" do
    root = PluginSpecHelper.tmp_path("collection-index-action-plugin")
    FileUtils.mkdir_p(File.join(root, "roles", "aprole", "action_plugins"))
    File.write(File.join(root, "roles", "aprole", "action_plugins", "warnx.py"), "# fixture\n")
    Krikri::CollectionIndex.reference_resolves?("warnx",
      role_path: File.join(root, "roles", "aprole"))[:resolves].must_equal(true)
  end

  it "still does not resolve a bare action name with no role-local action_plugins file" do
    root = PluginSpecHelper.tmp_path("collection-index-no-action-plugin")
    FileUtils.mkdir_p(File.join(root, "roles", "bare-role", "tasks"))
    Krikri::CollectionIndex.reference_resolves?("warnx",
      role_path: File.join(root, "roles", "bare-role"))[:resolves].must_equal(false)
  end

  # ------------------------------------------------------------------
  # Which collections krikri knows at all (the tombstone redirect hop and
  # the FQCN lookup not-found gate ride on this). Baked, so it is the same
  # on every controller.

  it "knows the captured collections and nothing else" do
    Krikri::CollectionIndex.known_collection?("community", "general").must_equal(true)
    Krikri::CollectionIndex.known_collection?("kubernetes", "core").must_equal(true)
    Krikri::CollectionIndex.known_collection?("freeipa", "ansible_freeipa").must_equal(false)
    Krikri::CollectionIndex.known_collection?("bodsch", "scm").must_equal(false)
  end

  # ------------------------------------------------------------------
  # The execution-side roots: kept ONLY so an executed python plugin's
  # `ansible.module_utils` imports can be resolved. They are never a
  # source of resolution/deprecation answers, and they no longer follow
  # the ansible-playbook on PATH.

  it "keeps the collection roots an executed python plugin imports from" do
    roots = Krikri::CollectionIndex.roots
    roots.any?(&.includes?(".ansible/collections")).must_equal(true)
    roots.includes?("/usr/share/ansible/collections").must_equal(true)
  end
end
