included: <WORK>/roles/Turgon37.apt/tasks/types/setting.yml for localhost => (item={'key': '00cdrom', 'value': {'content': 'Acquire::cdrom {\n  mount "/media/cdrom";\n};\nDir::Media::MountPath "/media/cdrom";\nAPT::Authentication::TrustCDROM "true";'}})
included: <WORK>/roles/Turgon37.apt/tasks/types/setting.yml for localhost => (item={'key': '01autoremove', 'value': {'content': 'APT::NeverAutoRemove {\n  "^firmware-linux.*";\n  "^linux-firmware$";\n  "^linux-image-[a-z0-9]*$";\n  "^linux-image-[a-z0-9]*-[a-z0-9]*$";\n};\n\nAPT::VersionedKernelPackages {\n  # linux kernels\n  "linux-image";\n  "linux-headers";\n  "linux-image-extra";\n  "linux-signed-image";\n  # kfreebsd kernels\n  "kfreebsd-image";\n  "kfreebsd-headers";\n  # hurd kernels\n  "gnumach-image";\n  # (out-of-tree) modules\n  ".*-modules";\n  ".*-kernel";\n  "linux-backports-modules-.*";\n  # tools\n  "linux-tools";\n};\n\nAPT::Never-MarkAuto-Sections {\n  "metapackages";\n  "contrib/metapackages";\n  "non-free/metapackages";\n  "restricted/metapackages";\n  "universe/metapackages";\n  "multiverse/metapackages";\n};\n\nAPT::Move-Autobit-Sections {\n  "oldlibs";\n  "contrib/oldlibs";\n  "non-free/oldlibs";\n  "restricted/oldlibs";\n  "universe/oldlibs";\n  "multiverse/oldlibs";\n};'}})
included: <WORK>/roles/Turgon37.apt/tasks/types/setting.yml for localhost => (item={'key': '01network', 'value': {'content': None}})
included: <WORK>/roles/Turgon37.apt/tasks/types/setting.yml for localhost => (item={'key': '01proxy', 'value': {'content': None}})
included: <WORK>/roles/Turgon37.apt/tasks/types/setting.yml for localhost => (item={'key': '02periodic', 'value': {'content': 'APT::Periodic::Enable "1";\nAPT::Periodic::Verbose "0";\nAPT::Periodic::RandomSleep "0";\nAPT::Periodic::MaxAge "0";\nAPT::Periodic::MinAge "2";\nAPT::Periodic::MaxSize "0";\nAPT::Periodic::AutocleanInterval "30";\nAPT::Periodic::CleanInterval "0";'}})
included: <WORK>/roles/Turgon37.apt/tasks/types/setting.yml for localhost => (item={'key': '02periodic-backup', 'value': {'content': 'APT::Periodic::BackupArchiveInterval "0";\nAPT::Periodic::BackupLevel "3";'}})
included: <WORK>/roles/Turgon37.apt/tasks/types/setting.yml for localhost => (item={'key': '15update-stamp', 'value': {'content': 'APT::Update::Post-Invoke-Success {"touch /var/lib/apt/periodic/update-success-stamp 2>/dev/null || true";};'}})
included: <WORK>/roles/Turgon37.apt/tasks/types/setting.yml for localhost => (item={'key': '15update-packages-lists', 'value': {'content': 'APT::Update::Post-Invoke-Success {"/opt/apt-scripts/update-packages-lists.sh || true";};\n'}})
included: <WORK>/roles/Turgon37.apt/tasks/types/setting.yml for localhost => (item={'key': '20auto-upgrades', 'value': {'content': 'APT::Periodic::Update-Package-Lists "0";\nAPT::Periodic::Unattended-Upgrade "0";\nAPT::Periodic::Download-Upgradeable-Packages "0";'}})
included: <WORK>/roles/Turgon37.apt/tasks/types/setting.yml for localhost => (item={'key': '20listchanges', 'value': {'content': None}})
included: <WORK>/roles/Turgon37.apt/tasks/types/setting.yml for localhost => (item={'key': '50unattended-upgrades', 'value': {'content': 'Unattended-Upgrade::Origins-Pattern {\n  "origin=Debian,codename=${distro_codename},label=Debian-Security";\n};\n\nUnattended-Upgrade::AutoFixInterruptedDpkg "true";\nUnattended-Upgrade::MinimalSteps "true";\nUnattended-Upgrade::InstallOnShutdown "false";\n\nUnattended-Upgrade::MailOnlyOnError "false";\n\nUnattended-Upgrade::Remove-Unused-Dependencies "false";\nUnattended-Upgrade::Automatic-Reboot "false";\nUnattended-Upgrade::Automatic-Reboot-WithUsers "false";\nUnattended-Upgrade::Automatic-Reboot-Time "now";\nUnattended-Upgrade::SyslogEnable "false";\nUnattended-Upgrade::SyslogFacility "daemon";'}})
included: <WORK>/roles/Turgon37.apt/tasks/types/setting.yml for localhost => (item={'key': '50unattended-upgrades-whitelist', 'value': {'content': 'Unattended-Upgrade::Package-Whitelist-Strict "true";\nUnattended-Upgrade::Package-Whitelist {\n};'}})
