#!/bin/sh
# Stand-in for rabbitmq-plugins: the `list -E -m` probe reports a broker
# where only rabbitmq_management is enabled, and any enable/disable dies the
# way the real CLI does for a plugin it does not ship.
sub="$1"
shift
if [ "$sub" = "list" ]; then
  printf 'rabbitmq_management\n'
  exit 0
fi
for arg in "$@"; do
  case "$arg" in
    --*) ;;
    *)
      printf 'Error:\n{:plugins_not_found, [:%s]}\n' "$arg" >&2
      exit 1
      ;;
  esac
done
exit 1
