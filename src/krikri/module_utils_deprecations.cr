require "json"
require "./collection_index"
require "./collection_runtime_data"

module Krikri
  # The deprecated `ansible.module_utils` imports real ansible-core 2.21 warns
  # about the moment a module payload (or a controller-side action plugin)
  # imports one, and which modules of this engine reach without python.
  #
  # ansible-core 2.21 turned `ansible.module_utils._text` into a shim whose
  # module-level __getattr__ deprecates every name imported from it - one
  # deprecation per name, in the importing module's own order - and
  # `ansible.module_utils.common._collections_compat` deprecates itself on
  # import. Collection releases still import from both paths, so real prints
  # a [DEPRECATION WARNING] (each distinct line once per run, behind the
  # one-time "can be disabled" hint) wherever that import happens, and its
  # registered result carries a matching `deprecations` entry per imported
  # name. krikri implements several of those modules natively, with no python
  # payload at all, so no import ever happens and real's lines went missing
  # (issue #1000: alecunsolo.cockpit's synchronize task lost the whole
  # trailer block).
  #
  # Which names those are is decided by the module payload's own captured
  # source: the import travels with the collection, and collections migrate
  # it away over time (ansible.posix 2.2.0 moved every catalogued module -
  # and the synchronize action plugin - onto
  # `ansible.module_utils.common.text.converters` and `collections.abc`, so
  # a controller resolving the 2.2.x line has NO import deprecations at all
  # and this code must print nothing either - issues #1060 and #1061, where
  # krikri printed the 2.1.x pair against a 2.2.x tree). That payload data is
  # BAKED into krikri (collection_runtime_data.cr, generated by
  # scripts/gen_collection_runtime_data.py from the pinned
  # ansible-core 2.21.6 + collections environment) instead of being read out
  # of an installed collection tree at run time: the same lines print on a
  # remote TARGET, on a controller with no collections installed and on a
  # fully populated one. The methods still take the resolved release's
  # version (CollectionIndex.module_provider_version, pinned on the plugin
  # wire) and model nothing once that collection's own known migration
  # boundary is reached - per collection, since amazon.aws through 11.2.x
  # still imports from the deprecated path while its 11.3.0 line migrated,
  # and no blanket ansible.posix cutoff can tell the two apart (issue
  # #1199). An unknown version models, the conservative default the engine
  # hardcoded before the resolved release became visible. The hand tables
  # below remain the fallback for a name the capture carries no payload for
  # (a module whose real source krikri never saw). Live-verified against
  # ansible-core 2.21.6 plus the ansible.posix 2.1.x/2.2.x,
  # containers.podman 1.18.x/1.19.x, and amazon.aws 10.1.1-11.2.0 module
  # sources.
  module ModuleUtilsDeprecations
    # The `_text` imports of the module payloads this engine runs without
    # python, for plugin binaries with no installed collection file to read
    # (see the intro). Keyed by the bare trailing segment because real
    # reaches the same module through its own FQCN and through
    # ansible.builtin's legacy redirect, and every spelling warns.
    # `patch` is deliberately absent: krikri has no patch plugin, so a
    # patch task never runs a module here.
    TEXT_IMPORT_DEPRECATIONS = {
      "acl"              => ["to_native"],
      "authorized_key"   => ["to_native"],
      "firewalld_info"   => ["to_native"],
      "mount"            => ["to_bytes", "to_native"],
      "podman_container" => ["to_bytes", "to_native"],
      "seboolean"        => ["to_text"],
      "synchronize"      => ["to_bytes", "to_native"],
      "sysctl"           => ["to_native"],
      # amazon.aws through 11.2.x's shared module_utils import chain, in
      # the order the payload's own imports translate into (live-verified
      # against 2.21.6 plus 10.1.1 and 11.2.0: each list below is exactly
      # the registered `deprecations` sequence, duplicates included - the
      # console collapses them by text, the result does not). These
      # native plugins run on the TARGET, which has no amazon.aws tree
      # for the installed-payload scan, so the pair real bundles from
      # the controller's collection can only come from this table
      # (issue #1199: ec2_vpc_net_info's task lost its to_native/to_text
      # lines on a remote host).
      "ec2_ami_info"        => ["to_native", "to_native", "to_native", "to_native", "to_text", "to_native", "to_text"],
      "ec2_instance"        => ["to_native", "to_native", "to_native", "to_native", "to_native", "to_text", "to_native", "to_text", "to_native"],
      "ec2_key"             => ["to_bytes", "to_native", "to_native", "to_native", "to_native", "to_text", "to_native", "to_text"],
      "ec2_metadata_facts"  => ["to_text"],
      "ec2_security_group"  => ["to_text", "to_native", "to_native", "to_native", "to_native", "to_text", "to_native", "to_text"],
      "ec2_vpc_net_info"    => ["to_native", "to_native", "to_native", "to_native", "to_text", "to_native", "to_text"],
      "ec2_vpc_subnet_info" => ["to_native", "to_native", "to_native", "to_native", "to_text", "to_native", "to_text"],
      "iam_user_info"       => ["to_native", "to_native", "to_native", "to_native", "to_text", "to_native"],
    }

    # Fallback-table modules whose collection moved the deprecated
    # imports out at a boundary other than ansible.posix's 2.2.0 one,
    # mapped to the FIRST release that no longer carries them
    # (source-verified against the tagged releases: containers.podman's
    # podman_container_lib.py opens with the `_text` pair through 1.18.2
    # and imports common.text.converters from 1.19.0 on - issue #1156;
    # amazon.aws 11.2.0 still imports from `_text` everywhere, 11.3.0
    # moved every module and module_utils file onto
    # common.text.converters).
    # The 2.2.0 gate alone would model the pair for every 1.x release
    # forever, including the ones real is silent on.
    LATER_MIGRATION_BOUNDARIES = {
      "podman_container" => {1, 19, 0},
      # community.docker 4.7.0's module_utils/common_api.py (and common.py)
      # opens with `from ansible.module_utils.common._collections_compat
      # import Mapping, Sequence`; 4.8.0 moved both onto
      # `ansible.module_utils.six.moves.collections_abc`, so that release
      # line warns nothing (source-verified against the 4.7.0 and 4.8.0
      # tags). The modules listed in COMPAT_IMPORT_DEPRECATIONS below reach
      # those files in 4.7.x.
      "docker_container"    => {4, 8, 0},
      "docker_image"        => {4, 8, 0},
      "docker_login"        => {4, 8, 0},
      "docker_network"      => {4, 8, 0},
      "docker_network_info" => {4, 8, 0},
      "ec2_ami_info"        => {11, 3, 0},
      "ec2_instance"        => {11, 3, 0},
      "ec2_key"             => {11, 3, 0},
      "ec2_metadata_facts"  => {11, 3, 0},
      "ec2_security_group"  => {11, 3, 0},
      "ec2_vpc_net_info"    => {11, 3, 0},
      "ec2_vpc_subnet_info" => {11, 3, 0},
      "iam_user_info"       => {11, 3, 0},
    }

    # ansible.posix's synchronize ACTION plugin imports to_text from the
    # deprecated `_text` path and MutableSequence from the deprecated
    # `_collections_compat` one (plugins/action/synchronize.py:25-26 in
    # 2.1.x), so real prints both lines when it loads that plugin on the
    # controller. Real loads action plugins lazily, immediately before the
    # task's own banner - a `when:` false synchronize still warns there,
    # live-verified against 2.21.6 - and, unlike the module payload's
    # imports, these leave NO entry on the registered result (a synchronize
    # result registers only the module's to_bytes/to_native pair). The
    # fallback for controllers with no installed collection file, keyed by
    # the bare trailing segment for the same reason as the module table
    # above; 2.2.x's action plugin migrated both imports (to
    # collections.abc and common.text.converters) and warns nothing.
    ACTION_PLUGIN_TEXT_IMPORT_DEPRECATIONS = {
      "synchronize" => ["to_text"],
    }

    # `_collections_compat` deprecates the MODULE rather than one imported
    # name (ansible/module_utils/common/_collections_compat.py's own
    # module-level deprecate() call), so its line has no "Importing ..." stem.
    COLLECTIONS_COMPAT_DEPRECATION_MSG  = "The `ansible.module_utils.common._collections_compat` module is deprecated."
    COLLECTIONS_COMPAT_DEPRECATION_TEXT = COLLECTIONS_COMPAT_DEPRECATION_MSG + " " \
                                                                               "This feature will be removed from ansible-core version 2.24. " \
                                                                               "Use `collections.abc` from the Python standard library instead."

    # Marks that module-level event inside the symbol lists below: unlike
    # every other entry it names no imported symbol, so text/result
    # formatting (and the fallback tables) must tell it apart.
    COLLECTIONS_COMPAT_SYMBOL = "__ansible_collections_compat__"

    # Modules whose real payload reaches `_collections_compat` instead of
    # (or besides) `_text`, for plugin binaries with no installed
    # collection file to read (see the intro). community.docker's
    # docker_container imports it through module_utils/module_container/
    # docker_api.py -> module_utils/common_api.py, and docker_image,
    # docker_login, docker_network and docker_network_info import
    # common_api directly; each shows up as the module's own
    # module-level deprecation event (issue #1318). Gated by
    # LATER_MIGRATION_BOUNDARIES above, so 4.8.0+ models nothing.
    COMPAT_IMPORT_DEPRECATIONS = Set{
      "docker_container",
      "docker_image",
      "docker_login",
      "docker_network",
      "docker_network_info",
    }

    # The `ansible.errors` names ansible-core 2.21 deprecates through that
    # module's own __getattr__, the `_text` shim's twin: Display merges the
    # entry's help text into the console line instead of the help text
    # field `_messages` keeps. An action plugin importing one prints the
    # line when real loads it - ansible.posix 2.1.x's patch.py imports
    # `_AnsibleActionDone` ahead of its own `_text` import, and a
    # `when:`-skipped patch task still loads the plugin, so the pair leads
    # that task's banner (issue #1198). The names belong to ansible-core,
    # not to the importing collection, and the removal versions are its
    # own.
    ERRORS_IMPORT_DEPRECATIONS = {
      "_AnsibleActionDone"     => {"version" => "2.23", "help_text" => "Return directly from action plugins instead."},
      "AnsibleFilterTypeError" => {"version" => "2.23", "help_text" => "Import 'AnsibleTypeError' instead."},
    }

    # The console line for one `ansible.errors` shim symbol, formatted the
    # way Display.deprecated merges msg, removal tail and help text.
    private def self.errors_import_deprecation_text(symbol : String) : String
      entry = ERRORS_IMPORT_DEPRECATIONS[symbol]
      "Importing '#{symbol}' is deprecated. " \
      "This feature will be removed from ansible-core version #{entry["version"]}. " \
      "#{entry["help_text"]}"
    end

    # The deprecated module_utils import events one module's payload makes,
    # in the module's own import order - a `_text` symbol, or
    # COLLECTIONS_COMPAT_SYMBOL for the module-level `_collections_compat`
    # deprecation; empty for every name outside the installed payload and
    # the fallback tables alike - and for every name when `collection_version`
    # pins a release that no longer makes those imports (the 2.2.0 gate
    # below, tightened per module by LATER_MIGRATION_BOUNDARIES).
    def self.text_import_deprecation_symbols(name : String?, collection_version : String? = nil) : Array(String)
      return [] of String unless name
      return [] of String unless deprecated_text_imports?(name, collection_version)
      if events = captured_payload_events(name)
        return events.map { |kind, symbol| kind == "compat" ? COLLECTIONS_COMPAT_SYMBOL : symbol }
      end
      leaf = name.split(".").last?
      symbols = TEXT_IMPORT_DEPRECATIONS[leaf]? || [] of String
      return symbols unless COMPAT_IMPORT_DEPRECATIONS.includes?(leaf)
      symbols + [COLLECTIONS_COMPAT_SYMBOL]
    end

    # The console text real prints for one imported symbol: the deprecation's
    # own message, Display's removal-version tail, and the `_text.py` shim's
    # help text joined onto one line (the help text is a separate `_messages`
    # field that only the console line merges in - see
    # text_import_deprecation_result_entries).
    def self.text_import_deprecation_texts(name : String?, collection_version : String? = nil) : Array(String)
      text_import_deprecation_symbols(name, collection_version).map do |symbol|
        symbol == COLLECTIONS_COMPAT_SYMBOL ? COLLECTIONS_COMPAT_DEPRECATION_TEXT : text_import_deprecation_text(symbol)
      end
    end

    # The `deprecations` entries those imports leave on the module result
    # (live-verified vs ansible-core 2.21.6 through `register`: the deprecator
    # resolves to ansible.builtin - `_text` is ansible-core's own
    # module_utils, not the importing module's collection - and the msg
    # carries no removal tail; only the console line does. The
    # `_collections_compat` event registers its msg alone, live-verified the
    # same way).
    def self.text_import_deprecation_result_entries(name : String?, collection_version : String? = nil) : Array(JSON::Any)
      text_import_deprecation_symbols(name, collection_version).map do |symbol|
        msg = if symbol == COLLECTIONS_COMPAT_SYMBOL
                COLLECTIONS_COMPAT_DEPRECATION_MSG
              else
                "Importing '#{symbol}' from 'ansible.module_utils._text' is deprecated."
              end
        deprecation_result_entry(msg)
      end
    end

    # The console texts real prints when it loads one controller-side action
    # plugin: its deprecated `ansible.errors` and `_text` imports in source
    # order, then the `_collections_compat` module deprecation when it
    # imports that too (the scanner preserves the kinds' relative order,
    # which synchronize's and patch's own import orders establish). The
    # action plugin real loads for a name ships beside the module payload
    # in the same collection; a collection whose install carries no
    # plugins/action/<leaf>.py loads no action plugin at all, so nothing
    # warns. Empty for every action plugin krikri implements without one -
    # and for every name when `collection_version` pins a 2.2.x-or-newer
    # release (see the header).
    def self.action_plugin_text_import_deprecation_texts(name : String?, collection_version : String? = nil) : Array(String)
      return [] of String unless name
      return [] of String unless deprecated_text_imports?(name, collection_version)
      if events = captured_action_events(name)
        return events.map do |kind, symbol|
          case kind
          when "text"   then text_import_deprecation_text(symbol)
          when "errors" then errors_import_deprecation_text(symbol)
          else               COLLECTIONS_COMPAT_DEPRECATION_TEXT
          end
        end
      end
      symbols = ACTION_PLUGIN_TEXT_IMPORT_DEPRECATIONS[name.split(".").last?]? || return [] of String
      texts = symbols.map { |symbol| text_import_deprecation_text(symbol) }
      # The one catalogued action plugin imports _collections_compat beside
      # _text (synchronize.py:26), in that order.
      texts + [COLLECTIONS_COMPAT_DEPRECATION_TEXT]
    end

    # Whether the resolved release can still carry the deprecated imports
    # this code models for `name`. Only a collection whose own catalogued
    # line migrated the import at a known release stops modeling it:
    # ansible.posix 2.2.x moved them (see the header) and containers.podman
    # moved podman_container_lib.py at 1.19.0 (LATER_MIGRATION_BOUNDARIES).
    # Every other collection's version says nothing here - amazon.aws
    # through 11.2.x still imports from the deprecated path (issue #1199),
    # so a blanket 2.2.0 cutoff would silence the lines real prints for
    # it.
    private def self.deprecated_text_imports?(name : String, collection_version : String?) : Bool
      if boundary = LATER_MIGRATION_BOUNDARIES[name.split(".").last?]?
        return CollectionIndex.version_before?(collection_version, boundary[0], boundary[1], boundary[2])
      end
      # Resolving the module's collection reads the controller's tree, and
      # the plugin process this runs in can have lost its own starting
      # directory (Dir.glob raises there - the command plugin's chdir:
      # case, see installed_payload_events). The answer only picks which
      # migration boundary applies, so an unreadable tree models like an
      # unknown collection rather than crashing the task.
      collection = begin
        CollectionIndex.module_provider_collection(name)
      rescue
        nil
      end
      if collection == "ansible.posix"
        return CollectionIndex.version_before?(collection_version, 2, 2, 0)
      end
      true
    end

    # One registered `deprecations` entry as ansible-core 2.21's
    # _return_formatted dumps it: msg first, no removal tail, the
    # ansible.builtin deprecator, version 2.24.
    def self.deprecation_result_entry(msg : String, version : String = "2.24") : JSON::Any
      JSON.parse({
        "msg"             => msg,
        "collection_name" => "ansible.builtin",
        "version"         => version,
        "deprecator"      => {
          "resolved_name" => "ansible.builtin",
          "type"          => nil,
        },
      }.to_json)
    end

    # The console line for one imported `_text` symbol.
    private def self.text_import_deprecation_text(symbol : String) : String
      "Importing '#{symbol}' from 'ansible.module_utils._text' is deprecated. " \
      "This feature will be removed from ansible-core version 2.24. " \
      "Use ansible.module_utils.common.text.converters instead."
    end

    # The deprecated imports of the module payload real would run for
    # `name`, in real's import-execution order, from krikri's BAKED capture
    # of that payload (see scripts/gen_collection_runtime_data.py): each
    # file's own deprecated imports at their statement position, each
    # `from`-import of a same-collection module_utils file recursing AT that
    # statement. Real executes the payload's whole IMPORT CHAIN, not just
    # the module file - containers.podman's podman_container carries no
    # `_text` import of its own; its module_utils/podman/
    # podman_container_lib.py opens with the to_bytes/to_native pair and the
    # shim deprecates when THAT import runs.
    #
    # nil when the capture carries no payload for the name (a module whose
    # real source krikri never saw): the modeled tables above answer then.
    # Either way the answer no longer depends on what this controller has
    # installed - a plugin binary running on a remote TARGET, a
    # collection-less controller and a fully populated one all print the
    # same lines, because they all read the same pinned data.
    private def self.captured_payload_events(name : String) : Array(Tuple(String, String))?
      # Follow the redirect chain before looking up, so a bare name
      # (`docker_container`, whose runtime redirects to
      # community.docker.docker_container) finds the captured payload instead
      # of falling through to the modeled tables - which would add a stray
      # `_collections_compat` the captured release no longer names.
      CollectionRuntimeData.module_deprecations[name]? ||
        CollectionRuntimeData.module_deprecations[CollectionIndex.module_redirect_chain(name)]?
    end

    # The same for the controller-side action plugin real loads for `name`:
    # the captured collection's plugins/action/<leaf>.py events, [] when the
    # captured release ships no action plugin beside its module (real then
    # loads none and nothing warns), nil when the capture knows nothing
    # about the plugin's collection at all (the modeled table answers).
    private def self.captured_action_events(name : String) : Array(Tuple(String, String))?
      resolved = CollectionIndex.module_redirect_chain(name)
      parts = resolved.split('.')
      return nil if parts.size < 3
      leaf = parts[2..].join('.')
      collection_fq = if parts[0] == "ansible" && (parts[1] == "builtin" || parts[1] == "legacy")
                        "ansible.builtin"
                      else
                        "#{parts[0]}.#{parts[1]}"
                      end
      inventory = CollectionRuntimeData.action_plugins[collection_fq]?
      return nil unless inventory
      inventory[leaf]? || [] of Tuple(String, String)
    end
  end
end
