{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Ansible role meta/main.yml",
  "description": "Written from the public Galaxy role metadata documentation.",
  "type": "object",
  "properties": {
    "allow_duplicates": {"type": "boolean"},
    "collections": {"type": "array", "items": {"type": "string"}},
    "dependencies": {
      "type": "array",
      "items": {
        "anyOf": [
          {"type": "string"},
          {"type": "object"}
        ]
      }
    },
    "galaxy_info": {
      "type": "object",
      "required": ["author", "description"],
      "properties": {
        "author": {"type": "string"},
        "company": {"type": "string"},
        "description": {"type": "string"},
        "github_branch": {"type": "string"},
        "issue_tracker_url": {"type": "string"},
        "license": {"type": "string"},
        "min_ansible_version": {"type": ["string", "number"]},
        "namespace": {"type": "string"},
        "role_name": {"type": "string"},
        "standalone": {"type": "boolean"},
        "galaxy_tags": {"type": "array", "items": {"type": "string"}},
        "platforms": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": {"type": "string"},
              "versions": {"type": "array"}
            }
          }
        }
      },
      "if": {
        "required": ["standalone"],
        "properties": {"standalone": {"const": true}}
      },
      "else": {
        "required": ["license", "min_ansible_version"]
      }
    }
  }
}
